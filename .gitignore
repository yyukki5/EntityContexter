## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore


# not using
.vs/
bin/*.xls?
bin/old/
bin/backup/
bin/resorce/
bin/*.cls
vbac.wsf
*.doccls
*.bat
~$*

# remove files for release
UnitTest.cls
UnitTests.bas
src/DbContexter.xlsm/*
!src/DbContexter.xlsm/EntityContexter.cls
!src/DbContexter.xlsm/Sample.bas
!src/DbContexter.xlsm/DbContextSample.cls

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates


